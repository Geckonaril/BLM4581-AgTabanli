
@{
    ViewData["Title"] = "Takvim";
}

<div class="container mt-4">
    <div class="text-center mb-4">
        <h1 class="display-5">Takvim Yönetim Sistemi</h1>
        <p class="text-muted">
            Etkinliklerinizi ve günlük planlarınızı tek yerden yönetin.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Takvimim</h4>
            <span class="badge bg-primary">İlk Sürüm</span>
        </div>

        <div class="card-body text-center py-5">
            <h5>Takvim uygulamasına hoş geldiniz!</h5>
            <p class="text-muted">
                Yakında etkinliklerinizi burada görüntüleyebileceksiniz.
            </p>
            <button class="btn btn-primary" disabled>
                + Etkinlik Ekle
            </button>
        </div>
    </div>
</div>
